# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env before starting the stack:
#   cp .env.example .env
#
# The defaults below run the FULL demo stack out of the box — no external
# credentials needed. Change them when you point the stack at real sources.
#
# ⚠ SECURITY NOTE: These are safe defaults for local use ONLY.
#   Do NOT use these credentials in any environment reachable from the network.
#   Change POSTGRES_PASSWORD before exposing port 5432 externally.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres credentials (shared across all services) ─────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── Database names ─────────────────────────────────────────────────────────────
# These databases are created automatically by init-db.sh on first Postgres start.
WAREHOUSE_DB=warehouse    # Two schemas inside: raw (EL landing) + analytics (dbt output)
DAGSTER_DB=dagster        # Dagster run history, event logs, and schedule state
METABASE_DB=metabase      # Metabase application data

# ── Service ports ──────────────────────────────────────────────────────────────
# Change these if you have port conflicts on your machine.
DAGSTER_PORT=3001
METABASE_PORT=3000
DEMO_MYSQL_PORT=3307

# ── MySQL source ───────────────────────────────────────────────────────────────
# Defaults point at the bundled mysql-demo container (synthetic e-commerce data).
# To extract from a REAL production MySQL: change these to your read-only
# replica credentials — nothing else in the stack needs to change.
MYSQL_HOST=mysql-demo
MYSQL_PORT=3306
MYSQL_USER=reader
MYSQL_PASSWORD=readonly
MYSQL_DATABASE=shop
# Prefix for landed raw tables: raw.<prefix>_<table>.
# Must match the source name used in dbt/models/sources.yml.
MYSQL_SOURCE_PREFIX=shop
# Root password for the demo MySQL container itself (not used by the pipeline).
DEMO_MYSQL_ROOT_PASSWORD=root

# ── HubSpot CRM (optional second source) ───────────────────────────────────────
# Leave empty to skip HubSpot entirely — the demo works without it.
# Create a Private App token at: HubSpot → Settings → Integrations → Private Apps
# Required scopes: crm.objects.companies.read, crm.objects.deals.read, crm.objects.owners.read
HUBSPOT_ACCESS_TOKEN=

# ── Metabase admin credentials ─────────────────────────────────────────────────
# REQUIRED — used by Dagster's dbt-metabase sync and by scripts/add_guardrail_headers.py
# Set these BEFORE running docker compose up for the first time.
# On first startup, use these same credentials in the Metabase setup wizard.
METABASE_USER=admin@example.com
METABASE_PASSWORD=change_me_before_use
